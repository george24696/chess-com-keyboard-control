{
  "manifest_version": 3,
  "name": "Chess.com Keyboard Control",
  "version": "1.0.0",
  "description": "Play chess.com with your keyboard. Move a cursor around the board with WASD, arrows or any keys, and press a key to click the highlighted square.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Chess.com Keyboard Control",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
